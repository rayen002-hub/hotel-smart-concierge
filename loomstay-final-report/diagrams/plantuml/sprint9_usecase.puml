@startuml sprint9_usecase
left to right direction
skinparam actorStyle awesome

actor "Gouvernante" as gov
actor "Responsable" as mgr
actor "Employé HK" as emp
actor "Administrateur" as admin

rectangle "Sprint 9 : Housekeeping, ménage et shifts" {
  usecase "Consulter chambres\noccupées" as UC1
  usecase "Assigner tâche\nménage quotidien" as UC2
  usecase "Gérer shifts\ndes employés" as UC3
  usecase "Exécuter tâche\nménage (Flutter)" as UC4
  usecase "Scanner QR\nentrée/sortie" as UC5
  usecase "Marquer tâche\n(DONE/SKIPPED)" as UC6
  usecase "Consulter journaux\nd'audit" as UC7
  usecase "Assigner tâche\nhousekeeping" as UC8
}

gov --> UC1
gov --> UC2
gov --> UC3
gov --> UC8
mgr --> UC3
emp --> UC4
emp --> UC5
emp --> UC6
admin --> UC7
UC4 ..> UC5 : <<include>>
UC4 ..> UC6 : <<include>>

@enduml
